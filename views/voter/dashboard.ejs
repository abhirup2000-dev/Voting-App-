<%- include('../partials/header', { title: 'Voter Dashboard' }) %>

<nav class="nav-top">
  <a href="/" class="brand text-decoration-none fs-5">🗳 VoteHub</a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-muted small">👤 <%= voter.name %></span>
    <form method="POST" action="/voter/logout" class="m-0">
      <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
    </form>
  </div>
</nav>

<div class="container py-4" style="max-width:720px">

  <%- include('../partials/flash') %>

  <!-- Voter Info -->
  <div class="card mb-4 p-4" style="background:#4f46e5;color:#fff;border-radius:12px">
    <h5 class="fw-bold mb-1"><%= voter.name %></h5>
    <p class="mb-1 opacity-75 small">EPIC: <strong><%= voter.epicNumber %></strong></p>
    <p class="mb-1 opacity-75 small">Constituency: <strong><%= voter.constituency %></strong></p>
    <p class="mb-0 opacity-75 small">Phone: <strong><%= voter.phone %></strong></p>
    <div class="mt-2">
      <% if (voter.isVoted) { %>
        <span class="badge bg-success">✓ Voted</span>
      <% } else { %>
        <span class="badge bg-warning text-dark">⏳ Not Voted Yet</span>
      <% } %>
    </div>
  </div>

  <% if (resultDeclared) { %>
    <!-- Result declared, voting closed -->
    <div class="card p-4 mb-4 text-center">
      <div class="fs-1 mb-2">🏆</div>
      <h5 class="fw-bold">Election is over!</h5>
      <p class="text-muted">The result has been declared. Voting is now closed.</p>
      <a href="/result" class="btn btn-primary">View Results</a>
    </div>

  <% } else if (voter.isVoted) { %>
    <!-- Already voted -->
    <div class="card p-4 mb-4 text-center">
      <div class="fs-1 mb-2">✅</div>
      <h5 class="fw-bold text-success">You have already cast your vote!</h5>
      <p class="text-muted">Thank you for participating in the election.</p>
      <a href="/result" class="btn btn-outline-primary btn-sm">View Results</a>
    </div>

  <% } else { %>
    <!-- Cast Vote -->
    <div class="card mb-4">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-1">Cast Your Vote</h5>
        <p class="text-muted small mb-4">Select one candidate. You can vote only once.</p>

        <% if (candidates.length === 0) { %>
          <p class="text-muted">No candidates available yet.</p>
        <% } else { %>
          <form method="POST" action="/voter/submit-vote">
            <div class="row g-3 mb-4">
              <% candidates.forEach(function(c) { %>
                <div class="col-sm-6">
                  <label class="d-block border rounded-3 p-3 cursor-pointer" style="cursor:pointer">
                    <div class="d-flex align-items-center gap-3">
                      <input type="radio" name="candidateId" value="<%= c._id %>" required style="width:18px;height:18px;flex-shrink:0"/>
                      <div>
                        <div class="fw-semibold"><%= c.name %></div>
                        <div class="text-muted small"><%= c.party %></div>
                      </div>
                    </div>
                  </label>
                </div>
              <% }) %>
            </div>
            <button type="submit" class="btn btn-primary px-4"
              onclick="return confirm('Confirm your vote? This cannot be undone.')">
              Submit Vote
            </button>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Update Password -->
  <div class="card">
    <div class="card-body p-4">
      <h5 class="fw-bold mb-3">Change Password</h5>
      <form method="POST" action="/voter/update-password">
        <div class="row g-3">
          <div class="col-sm-6">
            <label class="form-label fw-semibold small">Current Password</label>
            <input type="password" name="oldPassword" class="form-control form-control-sm" required/>
          </div>
          <div class="col-sm-6">
            <label class="form-label fw-semibold small">New Password</label>
            <input type="password" name="newPassword" class="form-control form-control-sm" required/>
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Update Password</button>
          </div>
        </div>
      </form>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
