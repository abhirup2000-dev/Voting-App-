<%- include('../partials/header', { title: 'Voter Registration' }) %>

<nav class="nav-top">
  <a href="/" class="brand text-decoration-none fs-5">🗳 VoteHub</a>
  <a href="/voter/login" class="btn btn-outline-primary btn-sm">Already registered? Login</a>
</nav>

<div class="container py-5" style="max-width:480px">
  <div class="card p-4">
    <h4 class="fw-bold mb-1 text-center">Voter Registration</h4>
    <p class="text-muted text-center small mb-4">Create your voter account</p>

    <%- include('../partials/flash') %>

    <form method="POST" action="/voter/register">
      <div class="mb-3">
        <label class="form-label fw-semibold">Full Name</label>
        <input type="text" name="name" class="form-control" placeholder="Enter your full name" required/>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Phone Number</label>
        <input type="text" name="phone" class="form-control" placeholder="10-digit mobile number" required/>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">EPIC Number <small class="text-muted">(Voter ID)</small></label>
        <input type="text" name="epicNumber" class="form-control" placeholder="e.g. ABC1234567" required/>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Constituency</label>
        <input type="text" name="constituency" class="form-control" placeholder="Your constituency" required/>
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold">Password</label>
        <input type="password" name="password" id="password" class="form-control" placeholder="Min. 6 characters" required/>
        <div class="form-check mt-1">
          <input class="form-check-input" type="checkbox" id="showPass" onchange="document.getElementById('password').type = this.checked ? 'text' : 'password'">
          <label class="form-check-label small text-muted" for="showPass">Show password</label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary w-100">Register</button>
    </form>
    <p class="text-center small text-muted mt-3 mb-0">Already have an account? <a href="/voter/login">Login</a></p>
  </div>
</div>

<%- include('../partials/footer') %>
