<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | VoteHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <style>
    body { background: #f5f7fa; }
    .brand { font-weight: 800; color: #4f46e5; letter-spacing: -0.5px; }
    .card { border: none; border-radius: 12px; box-shadow: 0 2px 16px rgba(0,0,0,0.07); }
    .btn-primary { background: #4f46e5; border-color: #4f46e5; }
    .btn-primary:hover { background: #3730a3; border-color: #3730a3; }
    .form-control:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,0.15); }
    .nav-top { background: #fff; border-bottom: 1px solid #e5e7eb; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; }
    .alert { border-radius: 8px; }
    table th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: #6b7280; font-weight: 600; }
  </style>
</head>
