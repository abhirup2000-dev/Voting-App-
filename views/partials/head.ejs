<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'VoteHub' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
  <style>
    :root {
      --primary: #4F46E5;
      --primary-dark: #3730a3;
      --accent: #06b6d4;
      --success: #10b981;
      --danger: #ef4444;
      --bg: #f8fafc;
      --card-shadow: 0 4px 24px rgba(79,70,229,0.08);
    }
    body { background: var(--bg); font-family: 'Segoe UI', system-ui, sans-serif; }
    .navbar-brand { font-weight: 800; letter-spacing: -0.5px; }
    .btn-primary { background: var(--primary); border-color: var(--primary); }
    .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
    .card { border: none; border-radius: 16px; box-shadow: var(--card-shadow); }
    .card-header { border-radius: 16px 16px 0 0 !important; }
    .form-control, .form-select { border-radius: 10px; padding: 10px 14px; }
    .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79,70,229,0.12); }
    .alert { border-radius: 12px; }
    .badge-pill { border-radius: 20px; padding: 6px 14px; }
    .hero-gradient { background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); }
    .stat-card { border-left: 4px solid var(--primary); }
    .table th { background: #f1f5f9; font-weight: 600; color: #475569; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
    .toast-container { position: fixed; top: 20px; right: 20px; z-index: 9999; }
    .spinner-overlay { display: none; position: fixed; inset: 0; background: rgba(255,255,255,0.7); z-index: 9998; align-items: center; justify-content: center; }
    .spinner-overlay.active { display: flex; }
  </style>
</head>
