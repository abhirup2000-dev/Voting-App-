<%- include('./partials/header', { title: 'Home' }) %>

<style>
  :root{
    --primary:#4f46e5;
    --secondary:#9333ea;
    --bg:#0b1020;
  }

  body {
    background: radial-gradient(1200px 600px at 20% -10%, rgba(79,70,229,.25), transparent),
                radial-gradient(1000px 500px at 100% 0%, rgba(147,51,234,.2), transparent),
                linear-gradient(180deg, #f8fafc, #eef2ff);
  }

  .nav-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 28px;
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .brand {
    font-weight: 900;
    letter-spacing: 0.6px;
  }

  .hero {
    text-align: center;
    padding: 100px 0 70px;
  }

  .hero h1 {
    font-size: 3.2rem;
    font-weight: 900;
    line-height: 1.2;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero p {
    color: #6b7280;
    max-width: 650px;
    margin: 15px auto 0;
  }

  .hero-buttons .btn{
    border-radius: 12px;
    font-weight: 600;
  }

  .badge-pill{
    display:inline-block;
    padding:6px 14px;
    border-radius:999px;
    background:rgba(79,70,229,.1);
    color:var(--primary);
    font-size:12px;
    margin-bottom:10px;
    font-weight:600;
  }

  .card {
    border: none;
    border-radius: 22px;
    transition: all 0.35s ease;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  }

  .card:hover {
    transform: translateY(-10px) scale(1.01);
    box-shadow: 0 30px 60px rgba(0,0,0,0.12);
  }

  .icon-box {
    width: 75px;
    height: 75px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg,#eef2ff,#e0e7ff);
    margin: 0 auto 18px;
    font-size: 30px;
  }

  .stats{
    display:flex;
    justify-content:center;
    gap:40px;
    margin-top:40px;
    flex-wrap:wrap;
  }

  .stat{
    text-align:center;
  }

  .stat h4{
    font-weight:800;
    margin:0;
  }

  .feature {
    text-align: center;
    padding: 25px;
  }

  .feature h6 {
    font-weight: 700;
    margin-top:10px;
  }

  .section {
    margin-top: 100px;
  }

  .cta-box{
    background: linear-gradient(135deg,var(--primary),var(--secondary));
    color:white;
    border-radius:24px;
    padding:50px 20px;
  }

  .cta-box .btn{
    border-radius:12px;
    font-weight:600;
  }

  .footer {
    margin-top: 100px;
    padding: 30px 0;
    text-align: center;
    color: #6b7280;
    border-top: 1px solid #e5e7eb;
  }
</style>

<nav class="nav-top">
  <span class="brand fs-5">🗳 VoteHub</span>
  <div class="d-flex gap-2">
    <a href="/voter/login" class="btn btn-outline-primary btn-sm">Voter Login</a>
    <a href="/admin/login" class="btn btn-primary btn-sm">Admin</a>
  </div>
</nav>

<div class="container">
  <!-- HERO -->
  <div class="hero">
    <div class="badge-pill">Next-gen voting system</div>
    <h1>Digital Voting, Reinvented</h1>
    <p class="fs-5">Secure, fast and transparent elections with modern technology and zero complexity.</p>

    <div class="hero-buttons d-flex justify-content-center gap-3 mt-4">
      <a href="/voter/register" class="btn btn-primary px-4 py-2">Get Started</a>
      <a href="/result" class="btn btn-outline-secondary px-4 py-2">View Results</a>
    </div>

    <div class="stats">
      <div class="stat">
        <h4>10K+</h4>
        <small class="text-muted">Votes Cast</small>
      </div>
      <div class="stat">
        <h4>500+</h4>
        <small class="text-muted">Candidates</small>
      </div>
      <div class="stat">
        <h4>99.9%</h4>
        <small class="text-muted">Uptime</small>
      </div>
    </div>
  </div>

  <!-- ROLE CARDS -->
  <div class="row g-4 justify-content-center">
    <div class="col-md-4">
      <div class="card p-4 text-center h-100">
        <div class="icon-box">🗳️</div>
        <h5 class="fw-bold">Voter</h5>
        <p class="text-muted small">Register and cast your vote securely.</p>
        <div class="mt-auto d-grid gap-2">
          <a href="/voter/register" class="btn btn-primary btn-sm">Register</a>
          <a href="/voter/login" class="btn btn-outline-primary btn-sm">Login</a>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card p-4 text-center h-100">
        <div class="icon-box">👤</div>
        <h5 class="fw-bold">Candidate</h5>
        <p class="text-muted small">Track performance and view election insights.</p>
        <div class="mt-auto d-grid">
          <a href="/candidate/login" class="btn btn-outline-primary btn-sm">Login</a>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card p-4 text-center h-100">
        <div class="icon-box">⚙️</div>
        <h5 class="fw-bold">Admin</h5>
        <p class="text-muted small">Manage elections and declare final results.</p>
        <div class="mt-auto d-grid gap-2">
          <a href="/admin/signup" class="btn btn-primary btn-sm">Create Account</a>
          <a href="/admin/login" class="btn btn-outline-primary btn-sm">Login</a>
        </div>
      </div>
    </div>
  </div>

  <!-- FEATURES -->
  <div class="section">
    <div class="text-center mb-4">
      <h3 class="fw-bold">Why VoteHub?</h3>
      <p class="text-muted">Engineered for modern digital elections</p>
    </div>

    <div class="row">
      <div class="col-md-4 feature">
        <div class="fs-2">🔐</div>
        <h6>Secure</h6>
        <p class="text-muted small">Token-based authentication with strong validation.</p>
      </div>
      <div class="col-md-4 feature">
        <div class="fs-2">⚡</div>
        <h6>Fast</h6>
        <p class="text-muted small">Real-time voting and instant processing.</p>
      </div>
      <div class="col-md-4 feature">
        <div class="fs-2">📊</div>
        <h6>Transparent</h6>
        <p class="text-muted small">Clear and auditable election system.</p>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="section text-center">
    <div class="cta-box">
      <h3 class="fw-bold">Ready to vote?</h3>
      <p>Join the future of elections today.</p>
      <a href="/voter/register" class="btn btn-light px-5 mt-2">Register Now</a>
    </div>
  </div>

<%- include('./partials/footer') %>


