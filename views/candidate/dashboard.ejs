<%- include('../partials/header', { title: 'Candidate Dashboard' }) %>

<nav class="nav-top">
  <a href="/" class="brand text-decoration-none fs-5">🗳 VoteHub</a>
  <div class="d-flex align-items-center gap-3">
    <span class="text-muted small">👤 <%= candidateName %></span>
    <form method="POST" action="/candidate/logout" class="m-0">
      <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
    </form>
  </div>
</nav>

<div class="container py-4" style="max-width:680px">
  <h4 class="fw-bold mb-4">Candidate Dashboard</h4>

  <%- include('../partials/flash') %>

  <% if (!result) { %>
    <!-- Result not declared -->
    <div class="card p-5 text-center">
      <div class="fs-1 mb-3">⏳</div>
      <h5 class="fw-bold">Result Not Declared Yet</h5>
      <p class="text-muted">The election is still in progress. Results will appear here once declared by the admin.</p>
    </div>

  <% } else { %>
    <!-- Winner banner -->
    <div class="card mb-4 p-4 text-center" style="background:#f59e0b;color:#fff;border-radius:12px">
      <div class="fs-2 mb-1">🏆</div>
      <h4 class="fw-bold mb-1">Winner: <%= result.results[0].name %></h4>
      <p class="mb-0 opacity-90"><%= result.results[0].party %> — <%= result.results[0].voteCount %> votes</p>
    </div>

    <!-- Full result table -->
    <div class="card">
      <div class="card-body p-0">
        <div class="px-4 pt-3 pb-2 border-bottom">
          <h5 class="fw-bold mb-0">Full Results</h5>
        </div>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr><th>Rank</th><th>Candidate</th><th>Party</th><th>Votes</th></tr>
            </thead>
            <tbody>
              <% result.results.forEach(function(r, i) { %>
                <tr class="<%= i === 0 ? 'table-warning' : '' %>">
                  <td class="fw-bold">#<%= i+1 %></td>
                  <td class="fw-semibold"><%= r.name %> <%= i === 0 ? '🏆' : '' %></td>
                  <td><span class="badge bg-secondary bg-opacity-10 text-secondary"><%= r.party %></span></td>
                  <td><strong><%= r.voteCount %></strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
