<%- include('../partials/header', { title: 'Admin Signup' }) %>

<nav class="nav-top">
  <a href="/" class="brand text-decoration-none fs-5">🗳 VoteHub</a>
  <a href="/admin/login" class="btn btn-outline-primary btn-sm">Admin Login</a>
</nav>

<div class="container py-5" style="max-width:480px">
  <div class="card p-4">
    <h4 class="fw-bold mb-1 text-center">Create Admin Account</h4>
    <p class="text-muted text-center small mb-4">Register a new election administrator</p>

    <%- include('../partials/flash') %>

    <form method="POST" action="/admin/signup">
      <div class="mb-3">
        <label class="form-label fw-semibold">Full Name</label>
        <input type="text" name="name" class="form-control" placeholder="Admin name" required/>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Email</label>
        <input type="email" name="email" class="form-control" placeholder="admin@example.com" required/>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Phone Number</label>
        <input type="text" name="phoneNumber" class="form-control" placeholder="10-digit number" required/>
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold">Password</label>
        <input type="password" name="password" id="password" class="form-control" placeholder="Min. 6 characters" required/>
        <div class="form-check mt-1">
          <input class="form-check-input" type="checkbox" id="showPass" onchange="document.getElementById('password').type = this.checked ? 'text' : 'password'">
          <label class="form-check-label small text-muted" for="showPass">Show password</label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary w-100">Create Account</button>
    </form>
    <p class="text-center small text-muted mt-3 mb-0">Already have an account? <a href="/admin/login">Login</a></p>
  </div>
</div>

<%- include('../partials/footer') %>
